// Shared logging mechanics. Formatting policy lives in sibling stashes.

borrow File
borrow Time

/// Controls the minimum level and destinations for emitted log events.
form Logger $
  /// The lowest numeric level accepted by this logger.
  minimum @@ int,
  /// Whether accepted events are written to standard output.
  stdout @@ bool,
  /// An optional UTF-8 file receiving accepted events.
  file @@ perchance[string],
\$

/// A structured logging event shared by every logging renderer.
form LogEvent $
  timestamp @@ string,
  level @@ int,
  label @@ string,
  message @@ string,
  context @@ map[string, string],
\$

/// Converts a public logging level name to its numeric severity.
given level_value(name @@ string) @@ int $
  if name == "debug" $ ret 10 \$
  if name == "info" $ ret 20 \$
  if name == "warning" $ ret 30 \$
  if name == "error" $ ret 40 \$
  scream("unknown logging level: " + name)
\$

/// Creates logging configuration for a named minimum level and destinations.
given make_logger(minimum @@ string, stdout @@ bool, file @@ perchance[string]) @@ Logger $
  ret Logger $
    minimum: level_value(minimum),
    stdout: stdout,
    file: file,
  \$
\$

/// Creates a timestamped structured logging event.
given make_event(level @@ int, label @@ string, message @@ string, context @@ map[string, string]) @@ LogEvent $
  ret LogEvent $
    timestamp: Time.utc(),
    level: level,
    label: label,
    message: message,
    context: context,
  \$
\$

/// Reports whether an event meets a logger's minimum severity.
given enabled(logger @@ Logger, event @@ LogEvent) @@ bool $
  ret event.level >= logger.minimum
\$

// stdout_line may contain ANSI escapes; file_line must not.
/// Emits separate terminal and plain-file renderings to enabled destinations.
given emit(logger @@ Logger, stdout_line @@ string, file_line @@ string) @@ unit $
  if logger.stdout $ say(stdout_line) \$
  if logger.file != naught $
    File.append(logger.file.pour_into(string), file_line + "\n")
  \$
\$

share Logger
share LogEvent
share level_value
share make_logger
share make_event
share enabled
share emit
