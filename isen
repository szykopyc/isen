#!/bin/sh
# The checked-in launcher keeps Isen pleasant to run while Rust owns the build.
isen_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
isen_binary="$isen_root/target/release/isen"

if [ ! -x "$isen_binary" ]; then
  echo "Isen has not been built yet." >&2
  echo "Run: cargo build --release --locked" >&2
  exit 127
fi

exec "$isen_binary" "$@"
