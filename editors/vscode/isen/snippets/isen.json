{
  "Function": {
    "prefix": "given",
    "body": [
      "given ${1:name}(${2}) @@ ${3:unit} $",
      "  ${0}",
      "\\$"
    ],
    "description": "Declare an Isen function"
  },
  "Form": {
    "prefix": "form",
    "body": [
      "form ${1:Name} $",
      "  ${2:field} @@ ${3:string},",
      "\\$"
    ],
    "description": "Declare an Isen form"
  },
  "Problem": {
    "prefix": "problem",
    "body": [
      "problem ${1:Name} $",
      "  ${2:field} @@ ${3:string},",
      "\\$"
    ],
    "description": "Declare an Isen problem"
  },
  "Declaration": {
    "prefix": "dec",
    "body": "dec ${1:name} @@ ${2:string} = ${0}",
    "description": "Declare an Isen value"
  },
  "Conditional": {
    "prefix": "if",
    "body": [
      "if ${1:condition} $",
      "  ${0}",
      "\\$"
    ],
    "description": "Create an Isen conditional"
  },
  "Each loop": {
    "prefix": "each",
    "body": [
      "each ${1:item} in ${2:values} $",
      "  ${0}",
      "\\$"
    ],
    "description": "Create an Isen collection loop"
  },
  "Recovery": {
    "prefix": "attempt",
    "body": [
      "attempt $",
      "  ${1}",
      "\\$ recover ${2:problem} @@ ${3:Problem} $",
      "  ${0}",
      "\\$"
    ],
    "description": "Create an Isen recovery block"
  }
}
