// MLP four-gram language model, trained entirely in Isen.
// Three position-specific projection matrices let word order interact before tanh.
borrow Array
borrow ML
borrow Args
borrow File
borrow List
borrow Map
borrow Maths
borrow Random
borrow String

given is_stop(word @@ string) @@ bool $
  ret word == "." || word == "!" || word == "?"
\$

given is_paragraph(word @@ string) @@ bool $
  ret word == "<paragraph>"
\$

given word_id(ids @@ map[string, int], word @@ string) @@ int $
  if Map.has(ids, word) $ ret ids[word] \$
  ret 0  // unk
\$

given random_array(length @@ int, spread @@ float) @@ arr[float] $
  dec values @@ arr[float] = Array.float(length, 0.0)
  dec index @@ int = 0
  aslongas index < length $
    values[index] = Random.float(-spread, spread)
    index = index + 1
  \$
  ret values
\$

given sigmoid(value @@ float) @@ float $
  ret 1.0 / (1.0 + Maths.exp(-value))
\$

given append_word(string @@ string, word @@ string) @@ string $
  if is_paragraph(word) $ ret string + "\n\n" \$
  if is_stop(word) $ ret string + word \$
  if string == "" $ ret word \$
  ret string + " " + word
\$

given context_key(left @@ int, middle @@ int, right @@ int) @@ string $
  ret left.pour_into(string) + "/" + middle.pour_into(string) + "/" + right.pour_into(string)
\$

given observed_next(fourgrams @@ map[string, int], context_totals @@ map[string, int],
  left @@ int, middle @@ int, right @@ int,
  vocabulary @@ int) @@ int $
  dec context @@ string = context_key(left, middle, right)
  if !Map.has(context_totals, context) $ ret -1 \$
  dec draw @@ int = Random.int(1, context_totals[context])
  dec cumulative @@ int = 0
  dec candidate @@ int = 1
  aslongas candidate < vocabulary $
    dec transition @@ string = context + "/" + candidate.pour_into(string)
    if Map.has(fourgrams, transition) $
      cumulative = cumulative + fourgrams[transition]
      if draw <= cumulative $ ret candidate \$
    \$
    candidate = candidate + 1
  \$
  ret -1
\$

given sample_next(left_embed @@ arr[float], middle_embed @@ arr[float], right_embed @@ arr[float],
  left_matrix @@ arr[float], middle_matrix @@ arr[float], right_matrix @@ arr[float],
  hidden_bias @@ arr[float], output @@ arr[float], output_bias @@ arr[float],
  left @@ int, middle @@ int, right @@ int, vocabulary @@ int,
  width @@ int, temperature @@ float) @@ int $
  dec hidden @@ arr[float] = Array.float(width, 0.0)
  ML.mlp_forward(hidden, hidden_bias,
    left_matrix, left_embed, left,
    middle_matrix, middle_embed, middle,
    right_matrix, right_embed, right, width)
  ret ML.softmax_sample(output, output_bias, hidden, vocabulary, width,
    temperature, right, 1.6)
\$

dec corpus_path @@ perchance[string] = Args.get(0)
if corpus_path == naught $
  say("usage: ./isen examples/mlp_lm.is -- <corpus.txt>")
  exit
\$
dec corpus @@ string = String.lower(File.read(corpus_path.pour_into(string)))
dec tokens @@ list[string] = String.paragraph_tokens(corpus)
dec token_count @@ int = size(tokens)
dec counts @@ map[string, int] = Map.string_int()
dec scan @@ int = 0
aslongas scan < token_count $
  dec token @@ string = tokens[scan]
  if !Map.has(counts, token) $
    counts[token] = 0
  \$
  counts[token] = counts[token] + 1
  scan = scan + 1
\$

// A larger vocabulary is affordable because training no longer scores every
// output word for every token. The long tail becomes the training-only unk id.
dec ids @@ map[string, int] = Map.string_int()
ids["unk"] = 0
dec vocabulary_words @@ list[string] = ["unk"]
dec vocabulary_limit @@ int = 1024
dec frequent_words @@ list[string] = Map.top_string_int(counts, vocabulary_limit - 1)
each vocabulary_token in frequent_words $
  if vocabulary_token != "unk" $
    ids[vocabulary_token] = size(vocabulary_words)
    vocabulary_words = List.push(vocabulary_words, vocabulary_token)
  \$
\$
say("vocabulary", size(vocabulary_words), "of", vocabulary_limit, "frequent words")

dec vocabulary @@ int = size(vocabulary_words)
dec token_ids @@ arr[int] = Array.int(token_count, 0)
scan = 0
aslongas scan < token_count $
  token_ids[scan] = word_id(ids, tokens[scan])
  scan = scan + 1
\$

// Exact observed continuations anchor the neural sampler when this context
// occurred in the corpus. Unknown-word contexts are deliberately ignored.
dec fourgrams @@ map[string, int] = Map.string_int()
dec context_totals @@ map[string, int] = Map.string_int()
scan = 0
aslongas scan < token_count - 3 $
  dec seen_left @@ int = token_ids[scan]
  dec seen_middle @@ int = token_ids[scan + 1]
  dec seen_right @@ int = token_ids[scan + 2]
  dec seen_target @@ int = token_ids[scan + 3]
  if seen_left != 0 && seen_middle != 0 && seen_right != 0 && seen_target != 0 $
    dec context @@ string = context_key(seen_left, seen_middle, seen_right)
    dec transition @@ string = context + "/" + seen_target.pour_into(string)
    if !Map.has(context_totals, context) $ context_totals[context] = 0 \$
    if !Map.has(fourgrams, transition) $ fourgrams[transition] = 0 \$
    context_totals[context] = context_totals[context] + 1
    fourgrams[transition] = fourgrams[transition] + 1
  \$
  scan = scan + 1
\$
say("observed four-gram contexts", size(context_totals))
// Six passes over a novel-sized excerpt give plenty of updates. Keeping this
// narrow is deliberate: the example should finish in an interpreter.
dec width @@ int = 24
dec left_embed @@ arr[float] = random_array(vocabulary * width, 0.08)
dec middle_embed @@ arr[float] = random_array(vocabulary * width, 0.08)
dec right_embed @@ arr[float] = random_array(vocabulary * width, 0.08)
dec left_matrix @@ arr[float] = random_array(width * width, 0.08)
dec middle_matrix @@ arr[float] = random_array(width * width, 0.08)
dec right_matrix @@ arr[float] = random_array(width * width, 0.08)
dec hidden_bias @@ arr[float] = Array.float(width, 0.0)
dec output @@ arr[float] = random_array(vocabulary * width, 0.08)
dec output_bias @@ arr[float] = Array.float(vocabulary, 0.0)
dec hidden @@ arr[float] = Array.float(width, 0.0)
dec hidden_gradient @@ arr[float] = Array.float(width, 0.0)
dec rate @@ float = 0.035
dec epoch @@ int = 0

aslongas epoch < 6 $
  dec position @@ int = 0
  dec loss @@ float = 0.0
  aslongas position < token_count - 3 $
    dec left @@ int = token_ids[position]
    dec middle @@ int = token_ids[position + 1]
    dec right @@ int = token_ids[position + 2]
    dec target @@ int = token_ids[position + 3]

    ML.mlp_forward(hidden, hidden_bias,
      left_matrix, left_embed, left,
      middle_matrix, middle_embed, middle,
      right_matrix, right_embed, right, width)
    Array.fill(hidden_gradient, 0, width, 0.0)

    // One real continuation plus nine random non-continuations.
    dec round @@ int = 0
    aslongas round < 10 $
      dec candidate @@ int = target
      dec label @@ float = 1.0
      if round > 0 $
        candidate = Random.int(0, vocabulary - 1)
        if candidate == target $ candidate = (candidate + 1) % vocabulary \$
        label = 0.0
      \$
      loss = loss + ML.sampled_update(output, output_bias, hidden,
        hidden_gradient, candidate, label, rate, width)
      round = round + 1
    \$

    ML.mlp_backprop(left_embed, left_matrix, middle_embed, middle_matrix,
      right_embed, right_matrix, hidden_bias, hidden, hidden_gradient,
      left, middle, right, width, rate)
    position = position + 1
  \$
  say("epoch", epoch + 1, "sampled loss",
    loss / ((token_count.pour_into(float) - 3.0) * 10.0))
  rate = rate * 0.85
  epoch = epoch + 1
\$

dec seed @@ int = 0
dec seed_ready @@ bool = false
dec attempts @@ int = 0
aslongas !seed_ready && attempts < 64 $
  seed = Random.int(0, token_count - 4)
  if token_ids[seed] != 0 && token_ids[seed + 1] != 0 && token_ids[seed + 2] != 0 $
    seed_ready = true
  \$
  attempts = attempts + 1
\$
dec left @@ int = token_ids[seed]
dec middle @@ int = token_ids[seed + 1]
dec right @@ int = token_ids[seed + 2]
dec generated @@ string = vocabulary_words[left] + " " + vocabulary_words[middle] + " " + vocabulary_words[right]
dec neural_only @@ bool = false
dec fourgram_percent @@ int = 60
dec step @@ int = 0
aslongas step < 120 $
  dec next @@ int = sample_next(left_embed, middle_embed, right_embed, left_matrix, middle_matrix, right_matrix, hidden_bias,
    output, output_bias, left, middle, right, vocabulary, width, 0.65)
  dec observed @@ int = observed_next(fourgrams, context_totals,
    left, middle, right, vocabulary)
  if !neural_only && observed >= 0 && Random.int(0, 99) < fourgram_percent $
    next = observed
  \$
  dec word @@ string = vocabulary_words[next]
  generated = append_word(generated, word)
  left = middle
  middle = right
  right = next
  step = step + 1
\$
say("\n" + generated)
